/* pages/index/index.wxss —— god-eye-view 暗色 HUD 风格 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #05060a;
  position: relative;
}

.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }
.dim { color: rgba(232, 234, 237, 0.42); }
.accent { color: #00d4ff; }

.glass {
  background: rgba(10, 12, 20, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.55);
}

/* ── 顶部 ─────────────────────────────────────────────── */
.hud-top {
  flex: 0 0 auto;
  padding: 16rpx 24rpx 12rpx;
  background: #080a11;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  z-index: 5;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.eye {
  width: 30rpx; height: 30rpx;
  border-radius: 50%;
  border: 1px solid #00d4ff;
  box-shadow: 0 0 14rpx rgba(0, 212, 255, 0.55), inset 0 0 8rpx rgba(0, 212, 255, 0.3);
  margin-right: 14rpx;
  position: relative;
}
.eye::after {
  content: '';
  position: absolute; left: 9rpx; top: 9rpx;
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #00d4ff;
  box-shadow: 0 0 10rpx #00d4ff;
}

.brand-txt { display: flex; flex-direction: column; flex: 1; }
.brand-title {
  font-size: 28rpx; font-weight: 600; letter-spacing: 3rpx; color: #e8eaed;
}
.brand-sub {
  font-size: 19rpx; color: rgba(232, 234, 237, 0.36); margin-top: 4rpx;
}

.badge {
  font-size: 19rpx; color: #00d4ff;
  padding: 4rpx 14rpx; border-radius: 20rpx;
  background: rgba(0, 212, 255, 0.13);
  border: 1px solid rgba(0, 212, 255, 0.3);
}

.search-row { display: flex; align-items: center; }

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  color: #e8eaed;
  font-size: 25rpx;
}
.ph { color: rgba(232, 234, 237, 0.28); }

.btn-search {
  margin-left: 14rpx;
  height: 76rpx; line-height: 76rpx;
  padding: 0 32rpx;
  background: #00d4ff;
  color: #04121a;
  font-size: 25rpx; font-weight: 700; letter-spacing: 2rpx;
  border-radius: 14rpx;
  box-shadow: 0 0 24rpx rgba(0, 212, 255, 0.35);
}

.chips {
  white-space: nowrap;
  margin-top: 16rpx;
  height: 52rpx;
  display: flex;
}
.chip {
  display: inline-block;
  padding: 0 22rpx;
  height: 52rpx; line-height: 52rpx;
  margin-right: 12rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: rgba(232, 234, 237, 0.55);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.chip.on {
  color: #00d4ff;
  background: rgba(0, 212, 255, 0.13);
  border-color: rgba(0, 212, 255, 0.45);
}

/* ── 地图 ─────────────────────────────────────────────── */
.map {
  flex: 1;
  width: 100%;
  min-height: 0;
}

/* ── 底部状态条 ───────────────────────────────────────── */
.hud-bottom {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx;
  background: #080a11;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

/* ── 结果列表 ─────────────────────────────────────────── */
.sheet {
  position: absolute;
  left: 20rpx; right: 20rpx; bottom: 90rpx;
  max-height: 46vh;
  display: flex;
  flex-direction: column;
  z-index: 20;
  overflow: hidden;
}
.sheet-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx 14rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  font-size: 19rpx; letter-spacing: 2rpx;
}
.close { color: #00d4ff; font-size: 22rpx; }
.sheet-body { max-height: 40vh; }

.row {
  display: flex; align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
.row:active { background: rgba(0, 212, 255, 0.09); }
.row-cs { font-size: 26rpx; font-weight: 600; color: #e8eaed; width: 160rpx; }
.row-air { flex: 1; font-size: 21rpx; color: rgba(232, 234, 237, 0.42); overflow: hidden; white-space: nowrap; }
.row-tag {
  font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 14rpx;
}
.row-tag.air { color: #00d4ff; background: rgba(0, 212, 255, 0.13); }
.row-tag.gnd { color: rgba(232, 234, 237, 0.38); background: rgba(255, 255, 255, 0.06); }
.row-num { font-size: 20rpx; color: rgba(232, 234, 237, 0.62); width: 110rpx; text-align: right; }

/* ── 详情卡 ───────────────────────────────────────────── */
.detail {
  position: absolute;
  left: 20rpx; right: 20rpx; bottom: 90rpx;
  z-index: 25;
  overflow: hidden;
}
.dt-head {
  display: flex; align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}
.dt-cs { font-size: 32rpx; font-weight: 700; color: #ffb020; margin-right: 16rpx; }
.dt-air { flex: 1; font-size: 22rpx; color: rgba(232, 234, 237, 0.6); }
.dt-close {
  width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  border-radius: 10rpx; font-size: 24rpx;
  color: rgba(232, 234, 237, 0.6);
  background: rgba(255, 255, 255, 0.06);
}

.dt-grid {
  display: flex; flex-wrap: wrap;
  padding: 18rpx 24rpx 8rpx;
}
.cell {
  width: 33.33%;
  display: flex; flex-direction: column;
  margin-bottom: 18rpx;
}
.cell .k { font-size: 18rpx; color: rgba(232, 234, 237, 0.32); letter-spacing: 1rpx; }
.cell .v { font-size: 25rpx; color: #e8eaed; margin-top: 4rpx; }

.dt-foot {
  display: flex; justify-content: space-between;
  padding: 0 24rpx 20rpx;
  font-size: 19rpx;
}
